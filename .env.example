DATABASE_URL=file:./dev.db
# For Neon production: DB_PROVIDER=postgresql; use a pooled DATABASE_URL with TLS.
# Migrations use a direct (non-pooler) URL; leave unset for local SQLite/Docker.
# DIRECT_URL=postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/vkc_mart?sslmode=require
DB_PROVIDER=sqlite
PORT=3001
JWT_SECRET=replace-this-with-at-least-32-random-characters
OWNER_PASSWORD=choose-a-strong-owner-password
STAFF_PASSWORD=choose-a-different-staff-password
SEED_SAMPLE_DATA=true
BACKUP_DIR=./backups
# Set to 1 only behind Render's reverse proxy.
TRUST_PROXY=0
# Open the shop directly without a sign-in page. Anyone with the URL has owner access.
PUBLIC_ACCESS=false
# Docker only: choose a long password using letters and digits (URL-safe).
POSTGRES_PASSWORD=choose-a-long-database-password
# Optional HTTPS deployment:
# POS_DOMAIN=pos.your-domain.in
